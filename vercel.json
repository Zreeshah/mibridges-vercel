{
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{"type": "host", "value": "www.mibridges.net"}],
      "destination": "https://mibridges.net/:path",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "X-Frame-Options", "value": "SAMEORIGIN"}
      ]
    }
  ]
}
